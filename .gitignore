# ===================================
# StockGuru — Comprehensive .gitignore
# Covers: Next.js, Node.js, Python, PostgreSQL, IDE
# ===================================

# ───────────────────────────────
# Next.js
# ───────────────────────────────
.next/
out/
build/
dist/
.turbo/

# ───────────────────────────────
# Node.js & npm
# ───────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.yarn/install-state.gz
package-lock.json

# ───────────────────────────────
# Environment & Secrets (NEVER commit these)
# ───────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.example

# ───────────────────────────────
# Python & Virtual Environments
# ───────────────────────────────
venv/
tfenv/
tfenv310/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.ipynb_checkpoints/
*.ipynb

# ───────────────────────────────
# Machine Learning / AI Models
# ───────────────────────────────
*.h5
*.keras
*.pkl
*.pth
*.onnx
*.tflite

# ───────────────────────────────
# CSV / Dataset Files
# ───────────────────────────────
*.csv
*.json.bak

# ───────────────────────────────
# Database
# ───────────────────────────────
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.bak
pgdata/

# ───────────────────────────────
# Logs
# ───────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
*.log.gz

# ───────────────────────────────
# OS Files
# ───────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
.Trash-*/

# ───────────────────────────────
# IDE & Editor
# ───────────────────────────────
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*.sublime-workspace
.editorconfig

# ───────────────────────────────
# Legacy / Backup Files
# ───────────────────────────────
legacy_backup/
my/
*.html.bak
*.bak

# ───────────────────────────────
# TypeScript
# ───────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ───────────────────────────────
# Vercel / Deployment
# ───────────────────────────────
.vercel/
.netlify/

# ───────────────────────────────
# Testing
# ───────────────────────────────
coverage/
.nyc_output/
test-results/
